# Normalize line endings across platforms
* text=auto eol=lf

# Source & Config
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary Assets (prevent line-ending corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
